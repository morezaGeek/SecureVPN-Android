<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <service android:name=".update.DailyUpdateCheck" android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <provider android:name=".update.UpdateFileProvider" android:authorities="${applicationId}.update-files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
